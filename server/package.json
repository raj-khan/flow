{
  "name": "isketch-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Hosted isketch diagrams: public links an AI can read",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
