{
  "name": "isketch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "isketch": "bin/isketch.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint . --fix",
    "check:secrets": "node scripts/check-secrets.mjs",
    "format": "prettier --write src/",
    "typecheck": "vue-tsc --noEmit -p jsconfig.json",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "isketch": "node bin/isketch.mjs",
    "examples": "for file in examples/*.flow; do node bin/isketch.mjs render \"$file\" -o \"${file%.flow}.svg\"; done",
    "brand": "node scripts/make-brand-images.mjs",
    "sitemap": "node scripts/make-sitemap.mjs",
    "landing": "node scripts/make-landing.mjs",
    "clip": "npm run build && node scripts/make-demo-clip.mjs"
  },
  "dependencies": {
    "@fontsource/patrick-hand": "^5.3.0",
    "@tanstack/vue-query": "^5.103.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-resizer": "^1.5.1",
    "fflate": "^0.8.3",
    "pinia": "^4.0.3",
    "roughjs": "^4.6.6",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "license": "MIT"
}
