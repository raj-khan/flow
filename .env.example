# Copy to .env.local to use. Nothing here is secret: Vite puts VITE_ values in the bundle.

# The origin the built page's canonical, Open Graph and JSON-LD links point at.
VITE_SITE_URL=https://isketch.online

# The isketch server (see server/ and the README) that Share publishes public
# links to. Leave it out and the app stays fully local; Share offers private
# links only.
# VITE_ISKETCH_API=https://isketch.online

# Google Analytics 4 measurement id, for production builds only. Cookieless
# (Consent Mode, storage denied); off in `vite dev`, in tests and inside frames.
# Counts page views and: brief_copied, exported, published, opened_from_link,
# mcp_setup_copied.
# VITE_GA_ID=G-XXXXXXXXXX
